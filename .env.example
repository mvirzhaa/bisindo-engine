# Salin file ini ke .env lalu sesuaikan

# Koneksi PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=bisindo_engine
PGUSER=bisindo
PGPASSWORD=bisindo_password

# Server
PORT=3000

# Ambang (threshold) confidence classifier (0-1)
RECOGNITION_CONFIDENCE_THRESHOLD=0.75

# Jumlah frame stabil berturut-turut sebelum sebuah tanda dikunci sebagai huruf/kata
STABILITY_FRAMES=8
